{
  "name": "@deepseek-ai/dsh-skill-state",
  "description": "DeepSeek Harness SKILL.state runtime: bounded execution state, state_patch, reducers, and hot prompt projection",
  "version": "0.2.0",
  "packageManager": "pnpm@11.7.0",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib/**/*.js", "lib/**/*.js.map", "lib/**/*.d.ts", "lib/**/*.d.ts.map", "src", "cordis.patch.yml", "README.md", "LICENSE"],
  "license": "MIT",
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "repository": { "type": "git", "url": "git+https://github.com/omdsh-dev/dsh-skill-state.git" },
  "keywords": ["dsh", "dsh-plugin", "agent", "state", "skill.state", "deepseek-harness"],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@types/node": "^22.20.0",
    "@tsconfig/node24": "^24.0.5",
    "oxfmt": "0.64.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "^0.22.2",
    "unrun": "^0.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "scripts": {
    "build": "tsdown --config-loader unrun --config tsdown.config.ts",
    "fmt": "oxfmt --config .oxfmtrc.json --write src tests",
    "fmt:check": "oxfmt --config .oxfmtrc.json --check src tests",
    "lint": "oxlint --config .oxlintrc.json --type-aware --type-check --deny-warnings src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run fmt:check && npm run lint && npm run typecheck && npm test && npm run build",
    "prepack": "npm run check"
  }
}
